{
  "name": "aichemy",
  "private": true,
  "version": "1.0.0",
  "description": "Aichemy — prompt builder visual dengan akses lifetime untuk kreator Indonesia",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-asset-index.mjs && vite build && tsx scripts/prerender.tsx && npm run build:server",
    "build:server": "esbuild server/index.ts server/migrate.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --out-extension:.js=.mjs",
    "db:generate": "npx --yes drizzle-kit@0.31.11 generate",
    "db:migrate": "node --env-file=.env --import tsx server/migrate.ts",
    "test": "node --env-file=.env.test --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "lucide-react": "^0.562.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
